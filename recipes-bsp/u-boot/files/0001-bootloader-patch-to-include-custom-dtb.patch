From f334c87b6c2d676b014710ce7d3af9dbcf45af97 Mon Sep 17 00:00:00 2001
From: Luca Lanzillotta <luquilanzi@gmail.com>
Date: Fri, 25 Jul 2025 20:17:15 +0000
Subject: [PATCH] bootloader patch to include custom dtb

---
 include/configs/phycore_imx8x.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/configs/phycore_imx8x.h b/include/configs/phycore_imx8x.h
index 9b199358933..8d62b38eae9 100644
--- a/include/configs/phycore_imx8x.h
+++ b/include/configs/phycore_imx8x.h
@@ -60,7 +60,7 @@
 	"cntr_addr=0x98000000\0"			\
 	"cntr_file=os_cntr_signed.bin\0" \
 	"boot_fdt=try\0" \
-	"fdt_file=imx8qxp-phytec-pcm-942.dtb\0" \
+	"fdt_file=imx8qxp-SCALES-Mariner1-B.dtb\0" \
 	"bootenv=bootenv.txt\0" \
 	"mmc_load_bootenv=fatload mmc ${mmcdev}:${mmcpart} ${bootenv_addr} ${bootenv}\0" \
 	"ipaddr=192.168.3.11\0" \

         /* 31 */
         "";
 
-	};
-
-	&adc0 {
-	    status = "disabled";
 	};	
 
 	/* New Added pins */
@@ -434,10 +430,10 @@ IMX8QXP_ADC_IN0_LSIO_GPIO1_IO10                 0x20000020
                                 IMX8QXP_ADC_IN2_LSIO_GPIO1_IO12                 0xA6070060

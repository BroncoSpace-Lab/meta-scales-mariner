From b71dbb68be8fccb284cf5324a7a6d0e3fdbb04cb Mon Sep 17 00:00:00 2001
From: Luca Lanzillotta <luquilanzi@gmail.com>
Date: Wed, 15 Oct 2025 00:50:26 +0000
Subject: [PATCH] added uart 2 functionality

---
 .../dts/freescale/imx8qxp-scales-mariner-1-b.dts  | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts b/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
index 2aadbf7a4b8e..249a85ce2e64 100644
--- a/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
@@ -322,6 +322,12 @@ &i2c3 {
         status = "okay";
 	};
 */
+	&lpuart2 {
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_lpuart2>;
+        status = "okay";
+        };
+
 &iomuxc {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_hog>;
@@ -370,7 +376,14 @@ IMX8QXP_UART0_RX_ADMA_UART0_RX	0x0600002c
 				IMX8QXP_UART0_TX_ADMA_UART0_TX	0x0600002c
 			>;
 		};
-	
+		
+		pinctrl_lpuart2: lpuart2grp{
+			fsl,pin = <
+				IMX8QXP_UART2_TX_ADMA_UART2_TX 0x0600002c
+				IMX8QXP_UART2_RX_ADMA_UART2_RX 0x0600002c
+		
+			>;
+		};
 		pinctrl_usdhc2_gpio: usdhc2gpiogrp {
 			fsl,pins = <
 				IMX8QXP_USDHC1_CD_B_LSIO_GPIO4_IO22	0x06000020
-- 
2.44.1


From 1508221feff466a5f055e8bb0eea34797c177894 Mon Sep 17 00:00:00 2001
From: Luca Lanzillotta <luquilanzi@gmail.com>
Date: Tue, 7 Oct 2025 18:29:33 +0000
Subject: [PATCH] replicating working gpio

---
 .../freescale/imx8qxp-scales-mariner-1-b.dts  | 25 +++++++++++--------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts b/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
index 95b86a884fd7..ff8e0c6a95e0 100644
--- a/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
@@ -67,7 +67,7 @@ i2c_rtc: rtc@52 {
 		interrupt-parent = <&lsio_gpio0>;
 		interrupts = <25 IRQ_TYPE_LEVEL_LOW>;
 		backup-switchover-mode = <0x1>;
-		status = "okay";
+		status = "disabled";
 	};
 
 	eeprom_cb: eeprom@51 {
@@ -313,6 +313,11 @@ &i2c3 {
 	status = "okay";
 	};
 
+
+	&adc0 {
+	 status = "disabled";
+	}
+
 &iomuxc {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_hog>;
@@ -425,15 +430,15 @@ IMX8QXP_QSPI0B_SS1_B_LSIO_QSPI0B_SS1_B	0x60
 		//GPIO1
 		pinctrl_gpio1: gpio1grp {
                         fsl,pins = <
-                                IMX8QXP_ADC_IN1_LSIO_GPIO1_IO09                 0xA6070060 
-                                IMX8QXP_ADC_IN0_LSIO_GPIO1_IO10                 0x20000020
-                                IMX8QXP_ADC_IN2_LSIO_GPIO1_IO12                 0xA6070060
-                                IMX8QXP_ADC_IN5_LSIO_GPIO1_IO13                 0xA6070060
-                                IMX8QXP_ADC_IN4_LSIO_GPIO1_IO14                 0xA6070060
-                                IMX8QXP_FLEXCAN1_RX_LSIO_GPIO1_IO17             0x26000020 //Modifying until it works. 
-                                IMX8QXP_FLEXCAN1_TX_LSIO_GPIO1_IO18             0x26000021  
-                                IMX8QXP_FLEXCAN2_RX_LSIO_GPIO1_IO19             0xA6000020 //mux mode enabled, high state on
-                                IMX8QXP_FLEXCAN2_TX_LSIO_GPIO1_IO20             0xA6000021 //mux mode "off", low state on
+                                IMX8QXP_ADC_IN1_LSIO_GPIO1_IO09                 0x26000020 
+                                IMX8QXP_ADC_IN0_LSIO_GPIO1_IO10                 0x26000020
+                                IMX8QXP_ADC_IN2_LSIO_GPIO1_IO12                 0x26000020
+                                IMX8QXP_ADC_IN5_LSIO_GPIO1_IO13                 0x26000020
+                                IMX8QXP_ADC_IN4_LSIO_GPIO1_IO14                 0x26000020
+                                IMX8QXP_FLEXCAN1_RX_LSIO_GPIO1_IO17             0x26000020 // Modifying until it works. Active High. 
+                                IMX8QXP_FLEXCAN1_TX_LSIO_GPIO1_IO18             0x26000020  
+                                IMX8QXP_FLEXCAN2_RX_LSIO_GPIO1_IO19             0x26000020 
+                                IMX8QXP_FLEXCAN2_TX_LSIO_GPIO1_IO20             0x26000020
                                 IMX8QXP_MIPI_DSI0_I2C0_SCL_LSIO_GPIO1_IO25      0xA6070060
                                 IMX8QXP_MIPI_DSI0_I2C0_SDA_LSIO_GPIO1_IO26      0xA6070060
                                 IMX8QXP_MIPI_DSI1_I2C0_SCL_LSIO_GPIO1_IO29      0xA6070060

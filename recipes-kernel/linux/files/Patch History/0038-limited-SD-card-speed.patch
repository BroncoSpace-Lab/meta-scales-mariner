From eeda9edc40c87437d4db048352fb4cf59cf564fd Mon Sep 17 00:00:00 2001
From: Luca Lanzillotta <luquilanzi@gmail.com>
Date: Tue, 14 Oct 2025 17:46:11 +0000
Subject: [PATCH] limited SD card speed

---
 arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts b/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
index b2e1a4376cfe..2aadbf7a4b8e 100644
--- a/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qxp-scales-mariner-1-b.dts
@@ -183,6 +183,9 @@ &usdhc2 {
 	pinctrl-2 = <&pinctrl_usdhc2_sd>, <&pinctrl_usdhc2_gpio>;
 	bus-width = <4>;
 	no-1-8-v;
+	no-uhs;
+        no-sd-highspeed;             
+        max-frequency = <25000000>; 
 	cd-gpios = <&lsio_gpio4 22 GPIO_ACTIVE_LOW>;
 	status = "okay";
 	};
-- 
